# Normalize line endings so the repository is usable on every platform:
# sources and docs stay LF, Windows scripts stay CRLF, and binary assets are untouched.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.pro text eol=lf
*.json text eol=lf

gradlew text eol=lf
*.sh text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.apk binary
*.aab binary
